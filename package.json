{
  "name": "dsh-session-title-rules",
  "version": "0.5.1",
  "type": "module",
  "description": "给 Agent 一个 session_title 工具：读标题、改名、检查质量、看历史；设置页含当前标题、开关、模型提示词与审计记录。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixieWithHeart/dsh-session-title-rules.git"
  },
  "homepage": "https://github.com/dixieWithHeart/dsh-session-title-rules",
  "bugs": {
    "url": "https://github.com/dixieWithHeart/dsh-session-title-rules/issues"
  },
  "license": "MIT",
  "author": "dixie_with_heart (https://github.com/dixieWithHeart)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-title",
    "rename",
    "audit"
  ]
}
